{
  "name": "context-correction-benchmark",
  "version": "3.1.0",
  "schema_version": 2,
  "description": "上下文 + LM 概率纠正 Benchmark 数据集（候选冻结）",
  "created": "2026-08-21",
  "status": "可用",
  "eval_command": "PYTHONPATH=. python scripts/eval_context_correction.py ../open-guji-dataset/context-correction --general-corpus corpus/external/daizhige_zhaoling.txt --book-corpus corpus/zongmu_wuyingdian_reference.txt --sweep 0,0.25,0.5,0.75,0.9,1.0 --lam 0.65 --surface-pref --max-rival-freq 2",
  "eval_script": "open-guji-cv scripts/eval_context_correction.py",
  "total_samples": 18731,
  "sample_unit": "页（目录 = 一页，页内所有列在 columns 数组里；计数单位是槽位）",
  "sources": [
    {
      "source_item": "book9",
      "split": "test",
      "pages": 9,
      "slots": 1405
    },
    {
      "source_item": "vol01",
      "split": "test",
      "pages": 60,
      "slots": 8041,
      "note": "按页型分层抽样自 89 个锚定页"
    },
    {
      "source_item": "vol02",
      "split": "test",
      "pages": 60,
      "slots": 8112,
      "note": "按页型分层抽样自 123 个锚定页"
    }
  ],
  "provenance_fields": [
    "source_item",
    "pipeline_version",
    "label_origin"
  ],
  "label_origin_values": [
    "align",
    "human",
    "synth"
  ],
  "metrics": [
    {
      "name": "baseline_top1",
      "type": "float",
      "direction": "higher_is_better",
      "description": "冻结候选的 top-1 基线（不做上下文纠正）"
    },
    {
      "name": "top1_gain",
      "type": "float",
      "direction": "higher_is_better",
      "description": "纠正后 top-1 相对基线的绝对提升，本集的主指标"
    },
    {
      "name": "harmful_flip_rate",
      "type": "float",
      "direction": "lower_is_better",
      "description": "把原本正确改错的比例（净收益的另一面，必须一并报告）"
    },
    {
      "name": "glyph_layer_immutability",
      "type": "bool",
      "target": "true",
      "description": "硬约束断言：字形层不可被语义层改写——纠正只允许在候选集合内重排，不得引入候选外的字，也不得修改 surface"
    },
    {
      "name": "gold_in_candidates_rate",
      "type": "float",
      "direction": "higher_is_better",
      "description": "金标在冻结候选里的比例（本集 0.9452）。1-它是重排永远碰不到的部分"
    },
    {
      "name": "headroom",
      "type": "float",
      "direction": "higher_is_better",
      "description": "金标在候选里但不是首选的比例（本集 0.0520）—— 重排能拿到的全部空间。报增益必须说清占了 headroom 的几成"
    }
  ],
  "fields": [
    {
      "name": "column_id",
      "type": "str",
      "description": "列标识（source_item + 页 + 列序）"
    },
    {
      "name": "context",
      "type": "object",
      "description": "列上下文：prev / next（相邻列已确认文本）"
    },
    {
      "name": "slots",
      "type": "list",
      "description": "槽位列表，每项 index / candidates / gold / frozen"
    },
    {
      "name": "slots[].candidates",
      "type": "list",
      "description": "冻结的候选：char / prob / source（prior|ocr|rapidocr|vlm|glyph|ref）"
    },
    {
      "name": "slots[].gold",
      "type": "str",
      "description": "该槽位金标字"
    },
    {
      "name": "corpus",
      "type": "str|null",
      "description": "评测所用语料标识（open-guji-cv `corpus/`），随样本记录以保证可复现"
    },
    {
      "name": "columns",
      "type": "list",
      "description": "页内各列；框架期骨架是一列一文件，一册几百列不可维护，故改为按页存（schema_version 2）。列的字段一个没变"
    },
    {
      "name": "slots[].instance_id",
      "type": "str",
      "description": "对应图块实例，与 char-ocr 交叉引用"
    },
    {
      "name": "slots[].cluster_id",
      "type": "str",
      "description": "所属簇，供簇级边缘化使用"
    },
    {
      "name": "slots[].cluster_size",
      "type": "int",
      "description": "簇大小"
    },
    {
      "name": "page_type",
      "type": "str",
      "description": "page-type 金标的页型"
    },
    {
      "name": "slots[].flags",
      "type": "list",
      "description": "phase4 图块自检标记"
    },
    {
      "name": "slots[].cluster_id",
      "type": "str",
      "description": "**册限定**的簇号 `<册>:<cid>`"
    }
  ],
  "sample_files": {
    "expected.json": "冻结的 (列上下文, 候选列表+概率, 金标字) + 溯源字段",
    "info.json": "来源、描述、标签"
  },
  "notes": "候选必须冻结在样本内：否则上游 OCR 一变，本集指标就不可比。语料来自 open-guji-cv `corpus/`。 本书语料必须挖掉测试页（评测脚本自动做，并打印挖掉字数）；通用语料的 8-gram 泄漏率也会打印。两个数不看就别看后面的指标。",
