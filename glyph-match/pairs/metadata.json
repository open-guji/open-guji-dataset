 "gold_definition": "same = 两个图块的金标 surface char 严格相同；diff = 不同。异体字/通假不算 same（语义精度是 eval_db_match 的另一本账）；图块质量不影响标签，走 tier 分层报",
 "sampling": {
  "knn": "HOG top-10 册内近邻 + top-5 跨册近邻。生产真正会去验的对群，操作点在它上面标",
  "random": "与特征无关的随机配对（同字 3000 / 异字 2000），recall 的无偏估计",
  "near_form": "NEVER_MATCH_FAMILIES 逐族配对，人裁来源的硬负例",
  "seed": 7
 },
 "sampling_bias": "knn 层由被测栈自己的第 3 层（HOG）选出，对群有偏——这是故意的（阈值就在这批对上生效），但 recall 的无偏值必须看 random 层。两层 recall 的差距（elastic 0.0740 vs 0.0157）就是偏置量",
 "stratification": [
  "ink_bucket（取对中较高一档，边界 [0.1, 0.14, 0.18, 0.25]）",
  "tier（任一侧 degraded 即 degraded）",
  "book（册内/跨册＝不同刻工）",
  "origin"
 ],
