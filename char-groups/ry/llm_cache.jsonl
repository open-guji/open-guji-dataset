{"id": "vol02:3:3:16", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "□□□□□經禀聖裁〓型萬世删定之㫖如【△】中天無所容□□其贊述所論次者詁經之說"}
{"id": "vol02:5:9:10", "model": "glm-4-flash", "answer": "曰", "conf": 1.0, "text": "衆說務取持平各明去取之故分爲十類曰易【△】書曰詩曰禮曰春秋曰孝經"}
{"id": "vol02:5:9:12", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "務取持平各明去取之故分爲十類曰易曰書【△】詩曰禮曰春秋曰孝經"}
{"id": "vol02:5:9:14", "model": "glm-4-flash", "answer": "曰", "conf": 0.95, "text": "持平各明去取之故分爲十類曰易曰書曰詩【△】禮曰春秋曰孝經"}
{"id": "vol02:5:9:16", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "各明去取之故分爲十類曰易曰書曰詩曰禮【△】春秋曰孝經"}
{"id": "vol02:5:9:19", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "取之故分爲十類曰易曰書曰詩曰禮曰春秋【△】孝經"}
{"id": "vol02:6:1:3", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "【△】五經總義曰四書曰樂曰小學經部一易類一"}
{"id": "vol02:6:1:11", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "曰五經總義曰四書【△】樂曰小學經部一易類一聖人覺世牖民大抵"}
{"id": "vol02:6:1:13", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "曰五經總義曰四書曰樂【△】小學經部一易類一聖人覺世牖民大抵因事"}
{"id": "vol02:9:1:5", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "議亦【△】按劉向七畧有子夏易傳但此書不行巳久今"}
{"id": "vol02:10:5:14", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "應麟困學紀聞所引皆今本所無德明鼎祚猶【△】在張弧以前應麟乃南宋末人何以當日所見"}
{"id": "vol02:14:6:9", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "費義居多實爲傳易之正脈齊陸澄與王儉書【△】王弼注易元學之所宗今若崇儒鄭注不可廢"}
{"id": "vol02:32:7:4", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "及晁氏讀書志皆以爲〓抄注疏以便講習故【△】口訣今詳考之實不盡然如乾彖引周氏說大"}
{"id": "vol02:44:7:12", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "書在宋時固以義理說易之宗也王得臣麈史【△】安定胡翼之皇祐至和間國子直講朝廷命主"}
{"id": "vol02:48:1:11", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "深至如解同人之彖【△】君子樂與人同小人樂與人異君子同其遠小"}
{"id": "vol02:69:9:3", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "爲無用之書〓衡說易眞可與論天人之際又【△】自昔遷貶之士率多怨懟感憤〓衡流落瘴鄉"}
{"id": "vol02:82:3:13", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "天曰通六子曰貴中曰初上定位曰六九定名【△】天地變卦曰論變有四曰有象曰求彖曰明位"}
{"id": "vol02:82:3:18", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "曰貴中曰初上定位曰六九定名曰天地變卦【△】論變有四曰有象曰求彖曰明位曰明君道曰"}
{"id": "vol02:84:6:10", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "迷復凶荀首論邲之戰稱周易有之在師之臨【△】師出以律否臧凶蔡墨論龍見于絳稱周易有"}
{"id": "vol02:119:6:20", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "曰安曰亨巳能安之則亨也以其在君故曰甘【△】吉言施之天下人皆美之然後爲吉也其論皆"}
{"id": "vol02:139:7:17", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "以人廢言也前有祓門人陳章序稱祓侍經筵【△】嘗以是經進講又稱祓别有易學舉隅四卷裒"}
{"id": "vol02:141:3:18", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "文如乾坤初爻初九潛龍勿用以下卽接以象【△】潛龍勿用陽在下也又接以文言曰潛龍勿用"}
{"id": "vol02:163:7:6", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "名義略如爾雅之釋詩故名曰雅其目曰通釋【△】書釋曰學釋曰情釋曰位釋曰象釋曰辭釋曰"}
{"id": "vol02:176:7:17", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "内府藏本宋朱元昇撰其子士立補葺元昇字【△】華里貫未詳惟卷首載咸淳八年兩浙提刑家"}
{"id": "vol02:183:8:7", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "易象以明義故曰象義其取象之例凡十有二【△】本體卽乾天坤地之類曰互體卽襍物𢰅德之"}
{"id": "vol02:183:9:8", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "體卽乾天坤地之類曰互體卽襍物𢰅德之旨【△】卦變彖所謂大往小來傳所謂柔"}
{"id": "vol02:184:9:13", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "二二比三是也曰原陽皆屬乾陰皆屬坤是也【△】納甲蠱之先甲後甲"}
{"id": "vol02:188:5:15", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "皆臣一以剌爲說者也其易筮通變凡五篇一【△】卜筮二日立則卦三日九六四日衍數五日命"}
{"id": "vol02:188:5:19", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "剌爲說者也其易筮通變凡五篇一日卜筮二【△】立則卦三日九六四日衍數五日命蓍亦多自"}
{"id": "vol02:188:6:4", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "其易筮通變凡五篇一日卜筮二日立則卦三【△】九六四日衍數五日命蓍亦多自岀新意不主"}
{"id": "vol02:188:6:8", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "變凡五篇一日卜筮二日立則卦三日九六四【△】衍數五日命蓍亦多自岀新意不主舊法白雲"}
{"id": "vol02:188:6:12", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "一日卜筮二日立則卦三日九六四日衍數五【△】命蓍亦多自岀新意不主舊法白雲霽道藏目"}
{"id": "vol03:7:4:3", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "爲内篇者三一曰舉要以發詞變象占之義二【△】明筮以考史傳卜筮卦占之法三曰辨疑以辨"}
{"id": "vol03:7:8:17", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "世諸法亦附錄其槪以其皆易之支流故别之【△】外大致與父之書互相出入而方平主於明本"}
{"id": "vol03:9:6:12", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "改包巟據說文及虞翻本大畜卦曰閑輿衛改【△】閑輿衛從鄭元虞翻陸希聲本萃卦萃亨刪亨"}
{"id": "vol03:13:2:7", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "曰卦對以奇偶反易成二卦成上下篇相對三【△】卦變言奇偶復生奇偶其用無窮四曰卦主因"}
{"id": "vol03:13:3:3", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "相對三曰卦變言奇偶復生奇偶其用無窮四【△】卦主因无妄傳而推之以明一經之義五曰變"}
{"id": "vol03:13:4:20", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "變卦言剛柔交相變而一卦可爲六十四卦六【△】互卦言中四爻復具二卦以爲一卦七曰象例"}
{"id": "vol03:13:8:15", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "曰辭例乃象例占例所未備而可以互見者十【△】變例言揲蓍四營十八變之法十一曰易原明"}
{"id": "vol03:22:9:4", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "義一曰卦變之義一曰卦名一曰易數之原一【△】易之詞義一曰易之占詞一曰蓍法一曰占"}
{"id": "vol03:22:9:20", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "原一曰易之詞義一曰易之占詞一曰蓍法一【△】占"}
{"id": "vol03:29:7:16", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "而約之改名通釋所著雲峰集中有與吳澄書【△】本義通釋郭文卿守浮梁時爲刋其半出之太"}
{"id": "vol03:50:1:3", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "【△】七分爲有圖之始寥寥千載至陳摶始本易有"}
{"id": "vol03:66:7:18", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "本傳是編因朱子易學啟䝉而闡明其說一卷【△】本圖書二卷曰原卦畫皆推演邵氏之學詳爲"}
{"id": "vol03:66:9:3", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "卷曰原卦畫皆推演邵氏之學詳爲圖解三卷【△】明蓍䇿亦發明古法而附論近世後二變不掛"}
{"id": "vol03:67:1:7", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "之誤四卷【△】考占變述六爻不變及六爻逓變之舊例五卷"}
{"id": "vol03:67:2:7", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "考占變述六爻不變及六爻逓變之舊例五卷【△】七占凡六爻不變六爻俱變及一爻變者皆仍"}
{"id": "vol03:68:4:15", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "喬周易古今文謂其繼䝉引而作㣲有異同其【△】存疑者洪朝選序謂存朱子之疑以羽翼程朱"}
{"id": "vol03:77:1:5", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "贛直【△】用事之例云出孟喜而孟喜之徒又以爲非劉"}
{"id": "vol03:90:3:13", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "攀龍之學岀入朱陸之間故以心言易然其說【△】天下有非易之心而無非心之易是故貴於學"}
{"id": "vol03:91:5:11", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "象三曰八卦正象四曰六爻位五曰卦爻畫六【△】卦變七曰互體八曰反對動爻大㫖謂文周之"}
{"id": "vol03:91:5:19", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "曰六爻位五曰卦爻畫六曰卦變七曰互體八【△】反對動爻大㫖謂文周之易卽象著理孔子之"}
{"id": "vol03:95:1:19", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "務以切於人事爲主故名曰用前有原序【△】義理無窮非言之所能盡故傳注於漢疏義於"}
{"id": "vol03:105:5:3", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "象故利行師於經文亦往往巧合惟其篇末有【△】或謂變乃易中之一義非畫卦作易之本㫖愚"}
{"id": "vol04:3:6:14", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "曹本榮奉勅撰首載順治十三年十二月十五【△】諭㫖次載順治十五年十月以漸等進書表次"}
{"id": "vol04:12:5:6", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "六三曰震坎皆木聚於艮山故爲林解屯九五【△】陷陰互艮止而不動解需九五曰坎水兌口故"}
{"id": "vol04:13:2:12", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "傳若夫雜物撰德辨是與非則非其中爻不備【△】物謂八卦之爻雜謂自其中四爻雜而互之又"}
{"id": "vol04:31:9:13", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "明夷對上經同人大有與下經夬姤對之類一【△】移易謂審其分聚計"}
{"id": "vol04:40:2:2", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "㫖主於隨爻闡義故餘不及焉非脫佚也讀易【△】鈔六卷山東巡撫採進本國朝張烈撰烈字武"}
{"id": "vol04:56:4:18", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "㢗目信其爲門人所依附其說尤明則朱子當【△】亦未嘗堅主其說也元陳應潤作爻變義藴始"}
{"id": "vol04:60:9:6", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "技之傳其說適足以亂易卽五行勝〓分卦直【△】一世二世三世四世諸說亦皆於三聖"}
{"id": "vol04:62:2:9", "model": "glm-4-flash", "answer": "日", "conf": 0.8, "text": "以詁經言數者奇偶黑白遞相推衍圖日積而【△】多反置象占詞變吉凶悔吝於不問其蠧蝕經"}
{"id": "vol04:80:2:15", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "曲說不廢義理而不爲理氣心性之空談在近【△】說易之家猶可云篤實近理焉周易孔義集說"}
{"id": "vol04:102:7:20", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "通者也四曰餘論單辭片語可資發明者也五【△】存疑六曰存異皆舊人訛舛之文似是者謂之"}
{"id": "vol04:133:3:7", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "王弼之學其上卷詳言互體之義下卷曰象統【△】明閏象統但存一序其說未竟明閏以六十四"}
{"id": "vol04:136:3:20", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "以隋經籍志有說卦三篇也此本仍作彖曰象【△】不作贊曰繫辭傳亦仍分上下不作說卦上下"}
{"id": "vol04:153:2:21", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "曰然則大有者非人乎物大然後可觀句則註【△】然則同人大有之時尚不可觀乎賁者飾也三"}
{"id": "vol04:153:7:12", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "然則需不巳早乎故受之以坎三句則註曰旣【△】陷矣而可受乎聖人豈欲陷人者哉遯者退也"}
{"id": "vol04:154:6:4", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "曰是不得入則終不說矣渙者離也二句則註【△】然則是離渙一卦也以渙繼坎不亦可乎如是"}
{"id": "vol04:203:8:18", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "題下經曰經之下題繫辭說卦序卦雜卦四傳【△】經之旁殊爲杜撰其名易疑者據其自述有曰"}
{"id": "vol04:206:3:12", "model": "glm-4-flash", "answer": "曰", "conf": 0.8, "text": "篤實近理然頗借以寓其私意如說亢龍有悔【△】夫以龍德而亢極猶有悔也時之旣極無論德"}
